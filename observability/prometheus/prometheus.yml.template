global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: production
    application: diesel-bridge

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager.railway.internal:9093

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: dieselbridge-api
    metrics_path: /metrics
    scheme: http
    authorization:
      type: Bearer
      credentials: ${METRICS_AUTH_TOKEN}
    static_configs:
      - targets:
          - ${API_PRIVATE_HOST}:${API_PORT}
