{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile.ets-sync"
  },
  "deploy": {
    "startCommand": "python3 scripts/easytruck_sync/nightly_sync.py",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER"
  }
}
