# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored and must NEVER be committed or pasted into a chat.

# Login credentials for easytruck.shop
ETS_EMAIL=
ETS_PASSWORD=

# Base URL and the shop scope segment (from the URL after login, e.g. sh_15mw458gpRl487OF)
ETS_BASE_URL=https://easytruck.shop
ETS_SHOP=sh_15mw458gpRl487OF

# Local target DB. Leave blank to use the backend's default (local dev).
# For a PRODUCTION resync, set this to the prod DATABASE_URL at run time
# (prefer exporting it in the shell over writing it here).
DATABASE_URL=
