FROM public.ecr.aws/docker/library/node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS browser
WORKDIR /browser
COPY backend/scripts/motive_sync/package*.json ./
RUN npm ci --omit=dev

FROM public.ecr.aws/docker/library/python:3.11-slim-bookworm@sha256:0a310eeecf4e1f5a0743f9a6520c90c88d089c903ca5fd283f501e3a805f5f89
WORKDIR /app
COPY --from=browser /usr/local/bin/node /usr/local/bin/node
COPY --from=browser /browser/node_modules /app/scripts/motive_sync/node_modules
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
RUN node /app/scripts/motive_sync/node_modules/playwright/cli.js install --with-deps chromium
COPY backend/ ./
ENV MOTIVE_DRIVER_COMMIT=false
CMD ["python", "-m", "scripts.motive_drivers.run_worker"]
