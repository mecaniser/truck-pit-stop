FROM node:22-alpine AS build
WORKDIR /usr/src/app
ENV CYPRESS_INSTALL_BINARY=0 NODE_OPTIONS=--max-old-space-size=1400
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV NODE_ENV=production SQUARE_ENVIRONMENT=sandbox \
    REACT_APP_AUTH0_DOMAIN=auth.tph.invalid REACT_APP_AUTH0_CLIENT_ID=local-test-client \
    REACT_APP_AUTH0_AUDIENCE=https://tph.invalid \
    REACT_APP_API_URL_RAILWAY=https://tph-test.elisprotech.com \
    REACT_APP_PAYMENTS_OFF=true REACT_APP_DISABLE_ANALYTICS=true \
    REACT_APP_ENABLE_MONTHLY_SUBSCRIPTIONS=false REACT_APP_LOG_LEVEL=silent
RUN npm run build
FROM node:22-alpine
WORKDIR /usr/src/app
ENV NODE_ENV=production
COPY --from=build /usr/src/app/node_modules ./node_modules
COPY --from=build /usr/src/app/build ./build
COPY --from=build /usr/src/app/backend ./backend
COPY --from=build /usr/src/app/shared ./shared
COPY --from=build /usr/src/app/public ./public
COPY package.json ./
COPY tph-web.cjs tph-worker.cjs tph-seed.cjs tph-probe.cjs ./
USER node
EXPOSE 5050
CMD ["node", "tph-web.cjs"]
