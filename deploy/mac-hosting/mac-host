#!/usr/bin/env python3
"""Operator entry point for this dedicated Mac's private application host."""
import json
from pathlib import Path
import shlex
import subprocess
import sys

SSH = ['ssh', '-i', str(Path.home() / '.ssh/dieselbridge_staging_ed25519'),
       '-o', 'IdentitiesOnly=yes', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=5',
       '-o', 'ExitOnForwardFailure=yes']
HOST = 'sergio@192.168.4.239'
REMOTE = ['/opt/homebrew/bin/python3', '/Users/sergio/mac-hosting/bin/hostctl.py']
args = sys.argv[1:]
if not args:
    raise SystemExit('Usage: mac-host status | deploy ... | rollback APP | backup | tunnel APP')
if args[0] == 'tunnel':
    if len(args) != 2:
        raise SystemExit('Usage: mac-host tunnel APP')
    raw = subprocess.check_output([*SSH, HOST, shlex.join([*REMOTE, 'status'])], text=True)
    matches = [x for x in json.loads(raw) if x['app'] == args[1]]
    if len(matches) != 1:
        raise SystemExit('Unknown hosted app')
    port = int(matches[0]['url'].rsplit(':', 1)[1])
    if not 18100 <= port <= 18199:
        raise SystemExit('Invalid hosted port')
    print('Open http://localhost:' + str(port) + ' while this tunnel runs.', flush=True)
    raise SystemExit(subprocess.call([*SSH, '-N', '-L', f'127.0.0.1:{port}:127.0.0.1:{port}', HOST]))
raise SystemExit(subprocess.call([*SSH, HOST, shlex.join([*REMOTE, *args])]))
